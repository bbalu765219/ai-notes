# ========================================================
# ChatGPT Notes Hub - Environment Configuration Template
# ========================================================

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=notes_hub_jwt_super_secret_key_2026

# AI Generation API Key (Optional - Fallback Sample Generator will be used if omitted)
# Google Gemini API key: Obtain free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Or OpenAI API key: https://platform.openai.com/
OPENAI_API_KEY=

# Default Administrator Credentials (Pre-seeded for testing)
ADMIN_EMAIL=admin@noteshub.com
ADMIN_PASSWORD=admin123

# Upload Moderation Setting
# true  = Auto-approve and publish PDF uploads immediately
# false = Queue uploads in Admin Dashboard for manual approval
AUTO_APPROVE_UPLOADS=false
